# Committed production values for the static build. Every NEXT_PUBLIC_* value
# is embedded in the exported site, so none of this is secret.

NEXT_PUBLIC_SITE_NAME=tipind
NEXT_PUBLIC_SITE_URL=https://tipind.mahiralamtohan.workers.dev
NEXT_PUBLIC_CONTACT_PHONE=+91 8766267499
NEXT_PUBLIC_WHATSAPP_NUMBER=918766267499
NEXT_PUBLIC_CONTACT_EMAIL=shop@tipind.ru
NEXT_PUBLIC_TELEGRAM_USERNAME=@tipind
NEXT_PUBLIC_SUPPORT_HOURS=Monday – Saturday · 9:00 AM – 8:00 PM IST

# Versioned catalog artifact and its build-time XOR obfuscation key.
NEXT_PUBLIC_CATALOG_DATA_URL=/data/catalog.d50350bf.dat
NEXT_PUBLIC_CATALOG_XOR_KEY="122166dd9e1d617243da9af8d7d3cd6f"

# Source sheet for `npm run catalog:build` (build-time only, never shipped).
CATALOG_SHEET_URL="https://script.google.com/macros/s/AKfycbzFRbjmjnm-n-BHTXiEo7FtPOJP0PyrEBx3bIz3QsAJLaq_UcyPj4bka96gis43mX0w/exec"
