# Cloudflare static-asset headers for the exported site (./out).
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Versioned catalog artifact produced by `npm run catalog:build`.
/data/*.dat
  Cache-Control: public, max-age=31536000, immutable
  Content-Type: application/octet-stream

/opengraph-image*
  Content-Type: image/png

/icon
  Content-Type: image/png

/apple-icon
  Content-Type: image/png

/manifest.webmanifest
  Cache-Control: public, max-age=3600
  Content-Type: application/manifest+json

# Checkout holds whatever the buyer typed; keep it out of search and archives.
/checkout/*
  X-Robots-Tag: noindex, nofollow, noarchive

/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; manifest-src 'self'; media-src 'self'; worker-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self' https://wa.me https://t.me; object-src 'none'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), microphone=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin
