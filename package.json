{
  "name": "tipind",
  "version": "0.1.0",
  "private": true,
  "overrides": {
    "minimatch": "^11.0.1"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "ESLINT_FULL_CHECK=true eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "check": "tsc --noEmit && ESLINT_FULL_CHECK=true eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "catalog:build": "node scripts/build-catalog.mjs --sheet \"https://script.google.com/macros/s/AKfycbzFRbjmjnm-n-BHTXiEo7FtPOJP0PyrEBx3bIz3QsAJLaq_UcyPj4bka96gis43mX0w/exec\" --clean --write-env",
    "verify": "node scripts/verify-export.mjs",
    "deploy": "node scripts/build-catalog.mjs --sheet \"https://script.google.com/macros/s/AKfycbzFRbjmjnm-n-BHTXiEo7FtPOJP0PyrEBx3bIz3QsAJLaq_UcyPj4bka96gis43mX0w/exec\" --clean --write-env && next build && node scripts/verify-export.mjs && wrangler deploy",
    "loadtest": "node scripts/loadtest.mjs --scenario cold",
    "loadtest:burst": "node scripts/loadtest.mjs --scenario burst --requests 10000 --concurrency 200",
    "loadtest:soak": "node scripts/loadtest.mjs --scenario soak --duration 120 --rate 100",
    "security": "node scripts/security-check.mjs",
    "security:audit": "node scripts/security-audit.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ci": "playwright test --reporter=list",
    "post-deploy-audit": "node scripts/post-deploy-audit.mjs",
    "preview": "node scripts/preview.mjs",
    "content:audit": "node scripts/content-audit.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "country-region-data": "^4.1.0",
    "libphonenumber-js": "^1.13.15",
    "lucide-react": "^1.53.0",
    "motion": "^14.0.0",
    "next": "16.4.5",
    "next-themes": "^0.4.6",
    "postcode-validator": "^3.10.26",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sonner": "^2.0.8",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@eslint-react/eslint-plugin": "^5.24.9",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@next/eslint-plugin-next": "^16.4.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^10.12.0",
    "eslint-config-next": "16.4.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-diff": "^2.1.7",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-react-compiler": "^19.1.0-rc.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-regexp": "^3.3.1",
    "eslint-plugin-security": "^4.2.0",
    "eslint-plugin-tailwindcss": "^4.4.0",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.70.0",
    "wrangler": "^4.0.0",
    "@playwright/test": "^1.52.0",
    "playwright": "^1.52.0"
  },
  "packageManager": "bun@1.4.2",
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
