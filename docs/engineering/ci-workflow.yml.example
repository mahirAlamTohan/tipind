# Copy this file to .github/workflows/ci.yml to enable CI.
name: CI

on:
  push:
    branches: [main]
  pull_request:

permissions:
  contents: read

concurrency:
  group: ci-${{ github.ref }}
  cancel-in-progress: true

jobs:
  check:
    name: Typecheck, lint, build
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-node@v4
        with:
          node-version: 22
          cache: npm

      - name: Install
        run: npm ci

      - name: Typecheck
        run: npm run typecheck

      - name: Lint
        run: npm run lint

      - name: Format check
        run: npm run format:check

      - name: Build static export
        run: npm run build

      - name: Verify the catalog artifact decodes
        # Guards against a broken/renamed catalog file or a mismatched XOR key.
        run: |
          node --input-type=module -e '
            import { readFileSync } from "node:fs"
            import { gunzipSync } from "node:zlib"
            const env = Object.fromEntries(
              readFileSync(".env.production", "utf8")
                .split("\n")
                .filter((line) => line.includes("=") && !line.trim().startsWith("#"))
                .map((line) => {
                  const [key, ...rest] = line.split("=")
                  return [key.trim(), rest.join("=").trim().replace(/^"|"$/g, "")]
                })
            )
            const url = env.NEXT_PUBLIC_CATALOG_DATA_URL
            const key = Buffer.from(env.NEXT_PUBLIC_CATALOG_XOR_KEY)
            const raw = readFileSync(`public${url}`)
            if (raw.subarray(0, 8).toString("ascii") !== "TIPCAT4:") {
              throw new Error("Catalog magic does not match format 4")
            }
            const masked = raw.subarray(8)
            const plain = Buffer.alloc(masked.length)
            for (let i = 0; i < masked.length; i += 1) {
              plain[i] = masked[i] ^ key[i % key.length]
            }
            const payload = JSON.parse(gunzipSync(plain).toString("utf8"))
            if (payload.format !== 4 || payload.products.length === 0) {
              throw new Error("Catalog payload is empty or has the wrong format")
            }
            console.log(`Catalog OK: ${payload.products.length} products`)
          '

      - name: Upload static export
        uses: actions/upload-artifact@v4
        with:
          name: static-export
          path: out
          retention-days: 7
