# Public site content is embedded in the static export. These values are visible in the browser.
NEXT_PUBLIC_SITE_NAME=tipind
NEXT_PUBLIC_SITE_URL=https://tipind.mahiralamtohan.workers.dev
NEXT_PUBLIC_CONTACT_PHONE=+91 8766267499
NEXT_PUBLIC_WHATSAPP_NUMBER=918766267499
NEXT_PUBLIC_CONTACT_EMAIL=shop@tipind.ru
NEXT_PUBLIC_TELEGRAM_USERNAME=@tipind
NEXT_PUBLIC_SUPPORT_HOURS=Monday – Saturday · 9:00 AM – 8:00 PM IST

# Set this to /data/catalog.<version>.json (written by `npm run catalog:build -- --write-env`).
NEXT_PUBLIC_CATALOG_DATA_URL=
# Public masking key for the catalog artifact (NOT a secret - it ships in the bundle).
NEXT_PUBLIC_CATALOG_XOR_KEY=tipind-catalog-mask-v6
